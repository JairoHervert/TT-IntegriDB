# --- Python (generador de datos sintéticos, y cualquier script futuro) ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- C/C++ ---
*.o
*.obj
*.a
*.so
*.out
*.exe
build/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
CTestTestfile.cmake

# --- Editor / SO ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Logs y datos generados que no van al repo ---
*.log
/tmp_*.sql

# --- Estado autenticado generado por tt_owner setup ---
# D~ pesa varios MB y delta se regenera con Setup.
setup/
setup_*/
authenticated_db*.bin
delta*.txt

# --- Respuestas generadas por tt_prover answer ---
respuesta*.bin

# --- Carpetas que prepara tt_owner publish para cada modulo ---
# Contienen D~ y la clave publica (varios MB); se regeneran con publish.
deploy/

# --- Claves generadas por tt_owner init ---
# La clave secreta sk_D nunca debe subirse; la publica se regenera con Init
# y pesa varios MB, asi que tampoco va al repositorio.
keys/
secret_key*.txt
public_key*.txt

# --- Otros secretos ---
.env
*.pem
*.key

comands_for_me.txt

# Escenarios de escalabilidad (datos y claves del propietario).
bench_data/
